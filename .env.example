# OpenAI (required for image generate / regenerate / rework)
OPENAI_API_KEY=sk-your-key-here

# Optional: override default image model (gpt-image-1 or dall-e-3)
# OPENAI_IMAGE_MODEL=gpt-image-1

# Optional online gate (HTTP Basic). Strongly recommended on a public URL.
# APP_USER=tutor
# APP_PASSWORD=choose-a-strong-password

# Optional paths (defaults: ./data/*.csv and DATA_DIR for cards/packs)
# SPELLINGS_CSV=/path/to/spellings.csv
# BIEMILLER_CSV=/path/to/biemiller.csv
# DATA_DIR=/var/data

# Image *creation* tools (OpenAI generate / Midjourney prompt export).
# Default off — UI focuses on choosing words + uploading pictures.
# Set to 1 to show creation tools again.
# FEATURE_IMAGE_CREATE=0
